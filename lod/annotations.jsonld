     {
      "type": "TextualBody",
      "purpose": "describing",
      "value": "The value function is concave for gains, convex for losses, and steeper for losses than gains (loss aversion); low probabilities are overweighted, contributing to both insurance and gambling.",
      "language": "en"
     }
    ],
    "target": [
     {
      "type": "SpecificResource",
