     {
      "type": "TextualBody",
      "purpose": "describing",
      "value": "AI safety is framed via accidents — unintended, harmful behavior from poor design — organized into five concrete research problems: avoiding side effects, avoiding reward hacking, scalable supervision, safe exploration, and distributional shift.",
      "language": "en"
     }
    ],
