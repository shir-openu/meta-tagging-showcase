    "body": [
     {
      "type": "TextualBody",
      "purpose": "describing",
      "value": "Using diachronic word embeddings (word2vec/PPMI/SVD) over six corpora, four languages, two centuries, two statistical laws of semantic change emerge: (i) law of conformity — change rate scales with an inverse power-law of word frequency; (ii) law of innovation — more polysemous words change faster, independent of frequency.",
      "language": "en"
     }
    ],
    "target": {
     "type": "SpecificResource",
     "source": "https://shir-openu.github.io/meta-tagging-showcase/papers/hamilton2016-diachronic-embeddings.html",
     "selector": {
      "type": "TextQuoteSelector",
      "exact": "we propose two quantitative laws of seman- tic change: (i) the law of conformity-the rate of semantic change scales with an inverse power-law of word frequency; (ii) the law of innovation-independent of frequency, words that are more polysemous have higher rates of semantic change.",
      "prefix": "r, independent of frequency. - \"",
      "suffix": "\" quantity 6 corpora / 4 languag"
     }
    }
