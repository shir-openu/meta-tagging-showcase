    "body": [
     {
      "type": "TextualBody",
      "purpose": "describing",
      "value": "Crossing pea (Pisum) plants with constant differing characters, hybrids show one character (dominant) while the other becomes latent (recessive); in the next generation dominant and recessive forms appear in an average ratio of 2.98:1 ≈ 3:1.",
      "language": "en"
     }
    ],
    "target": [
     {
      "type": "SpecificResource",
      "source": "https://shir-openu.github.io/meta-tagging-showcase/papers/mendel1866-plant-hybridization.html",
      "selector": {
       "type": "TextQuoteSelector",
       "exact": "are termed the dominant, and those which become latent in the process recessive",
       "prefix": "erage ratio of 2.98:1 ≈ 3:1. - \"",
       "suffix": "... an average ratio of 2.98:1, "
      }
     },
     {
      "type": "SpecificResource",
      "source": "https://shir-openu.github.io/meta-tagging-showcase/papers/mendel1866-plant-hybridization.html",
      "selector": {
       "type": "TextQuoteSelector",
       "exact": "an average ratio of 2.98:1, or 3:1",
       "prefix": "ent in the process recessive... ",
       "suffix": "\" finding Mendel selected Pisum "
      }
     }
    ]
   },
