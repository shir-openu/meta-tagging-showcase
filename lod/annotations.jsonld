    "generator": {
     "id": "https://shir-openu.github.io/meta-tagging-showcase/",
     "type": "Software",
     "name": "Meta-Tagging Project tag layer"
    },
    "body": [
     {
      "type": "TextualBody",
      "purpose": "describing",
      "value": "From high-frequency data, log-volatility behaves like a fractional Brownian motion with Hurst exponent H≈0.1 (H<1/2, rough) at all reasonable time scales — motivating the Rough FSV (RFSV) model, which fits financial time series and improves realized-volatility forecasts.",
      "language": "en"
     }
    ],
    "target": [
     {
      "type": "SpecificResource",
      "source": "https://shir-openu.github.io/meta-tagging-showcase/papers/gatheral2018-rough-volatility.html",
      "selector": {
       "type": "TextQuoteSelector",
       "exact": "Our main result is that log-volatility behaves essentially as a fractional Brownian motion with Hurst exponent H of order 0.1, at any reasonable time scale",
       "prefix": "alized-volatility forecasts. - \"",
       "suffix": "... We call our model Rough FSV "
      }
     },
     {
      "type": "SpecificResource",
      "source": "https://shir-openu.github.io/meta-tagging-showcase/papers/gatheral2018-rough-volatility.html",
      "selector": {
       "type": "TextQuoteSelector",
       "exact": "We call our model Rough FSV (RFSV) to underline that, in contrast to FSV, H < 1/2.",
       "prefix": "at any reasonable time scale... ",
       "suffix": "\" finding Although volatility is"
      }
     }
    ]
   },
   {
    "id": "https://shir-openu.github.io/meta-tagging-showcase/lod/annotations.jsonld#gatheral2018-rough-volatility--findings-1",
    "type": "Annotation",
    "motivation": "describing",
