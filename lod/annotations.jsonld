     "id": "https://shir-openu.github.io/meta-tagging-showcase/",
     "type": "Software",
     "name": "Meta-Tagging Project tag layer"
    },
    "body": [
     {
      "type": "TextualBody",
      "purpose": "describing",
      "value": "Although volatility is NOT long-memory under RFSV, classical persistence tests spuriously detect long memory in RFSV-generated data — explaining why long memory became an accepted stylized fact.",
      "language": "en"
     }
    ],
    "target": {
     "type": "SpecificResource",
     "source": "https://shir-openu.github.io/meta-tagging-showcase/papers/gatheral2018-rough-volatility.html",
     "selector": {
      "type": "TextQuoteSelector",
      "exact": "classical statistical procedures aiming at detecting volatility persistence tend to conclude the presence of long memory in data generated from it. This sheds light on why long memory of volatility has been widely accepted as a stylized fact.",
      "prefix": "e an accepted stylized fact. - \"",
      "suffix": "\" quantity H ≈ 0.1 - Hurst expon"
     }
    }
   },
