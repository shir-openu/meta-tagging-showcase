  dct:isPartOf <https://shir-openu.github.io/meta-tagging-showcase/lod/> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/vocab.html#scheme-methods>
  a skos:ConceptScheme ;
  dct:title "Methods"@en ;
  dct:description "How the work was carried out."@en ;
  dct:creator <https://orcid.org/0009-0000-2597-2824> ;
