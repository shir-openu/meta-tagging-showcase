  dct:isPartOf <https://shir-openu.github.io/meta-tagging-showcase/lod/> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/vocab.html#scheme-concepts>
  a skos:ConceptScheme ;
  dct:title "Domain concepts"@en ;
  dct:description "Concepts named in the papers. Only those shared by two or more papers are given URIs -- a concept used once is not yet a join key."@en ;
  dct:creator <https://orcid.org/0009-0000-2597-2824> ;
  dct:publisher "Department of Mathematics and Computer Science, The Open University of Israel" ;
  dct:license <https://creativecommons.org/licenses/by/4.0/> ;
  dct:rights "© Shir Sivroni. Licensed CC BY 4.0. Attribution: Sivroni, S. A Verbatim-Grounded, Field-Neutral Tag Layer for Cross-Disciplinary Reading of Academic Literature. doi:10.5281/zenodo.21432188 (CC BY 4.0)." ;
  dct:isPartOf <https://shir-openu.github.io/meta-tagging-showcase/lod/> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/vocab.html#scheme-statistics>
  a skos:ConceptScheme ;
  dct:title "Statistical terms"@en ;
  dct:description "The most portable layer in the corpus: the same terms recur across every discipline, which is what makes them usable as join keys."@en ;
  dct:creator <https://orcid.org/0009-0000-2597-2824> ;
  dct:publisher "Department of Mathematics and Computer Science, The Open University of Israel" ;
  dct:license <https://creativecommons.org/licenses/by/4.0/> ;
  dct:rights "© Shir Sivroni. Licensed CC BY 4.0. Attribution: Sivroni, S. A Verbatim-Grounded, Field-Neutral Tag Layer for Cross-Disciplinary Reading of Academic Literature. doi:10.5281/zenodo.21432188 (CC BY 4.0)." ;
  dct:isPartOf <https://shir-openu.github.io/meta-tagging-showcase/lod/> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/vocab.html#scheme-places>
  a skos:ConceptScheme ;
  dct:title "Places"@en ;
  dct:description "Publication places, reconciled to Wikidata and, through it, to GeoNames."@en ;
