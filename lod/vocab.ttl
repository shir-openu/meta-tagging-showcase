<https://shir-openu.github.io/meta-tagging-showcase/lod/vocab.html#scheme-statistics>
  a skos:ConceptScheme ;
  dct:title "Statistical terms"@en ;
  dct:description "The most portable layer in the corpus: the same terms recur across every discipline, which is what makes them usable as join keys."@en ;
