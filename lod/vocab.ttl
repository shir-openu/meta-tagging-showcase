<https://shir-openu.github.io/meta-tagging-showcase/lod/vocab.html#scheme-concepts>
  a skos:ConceptScheme ;
  dct:title "Domain concepts"@en ;
  dct:description "Concepts named in the papers. Only those shared by two or more papers are given URIs -- a concept used once is not yet a join key."@en ;
  dct:creator <https://orcid.org/0009-0000-2597-2824> ;
  dct:publisher "Department of Mathematics and Computer Science, The Open University of Israel" ;
