<https://shir-openu.github.io/meta-tagging-showcase/lod/>
  a dcat:Dataset, schema:Dataset ;
  dct:title "Meta-Tagging Project — verbatim-grounded tag layer (SKOS vocabulary and Web Annotations)"@en ;
  dct:creator <https://orcid.org/0009-0000-2597-2824> ;
  dct:publisher "Department of Mathematics and Computer Science, The Open University of Israel" ;
  dct:license <https://creativecommons.org/licenses/by/4.0/> ;
  dct:issued "2026-07-28" ;
  dct:identifier "https://doi.org/10.5281/zenodo.21432188" ;
  dct:bibliographicCitation "Sivroni, S. A Verbatim-Grounded, Field-Neutral Tag Layer for Cross-Disciplinary Reading of Academic Literature. doi:10.5281/zenodo.21432188 (CC BY 4.0)." ;
  schema:codeRepository <https://github.com/shir-openu/meta-tagging-showcase> ;
  schema:sameAs <https://doi.org/10.5281/zenodo.21432188>, <https://github.com/shir-openu/meta-tagging-showcase>, <https://shir-openu.github.io/meta-tagging-showcase/> ;
  dct:source <https://shir-openu.github.io/meta-tagging-showcase/> ;
  foaf:homepage <https://shir-openu.github.io/meta-tagging-showcase/> .

<https://orcid.org/0009-0000-2597-2824>
  a foaf:Person ;
  foaf:name "Shir Sivroni" ;
  schema:affiliation "Department of Mathematics and Computer Science, The Open University of Israel" ;
  schema:identifier "https://orcid.org/0009-0000-2597-2824" .

<https://shir-openu.github.io/meta-tagging-showcase/lod/ns#accessStatus>
  a rdf:Property ;
  rdfs:label "access status" ;
  rdfs:comment "How this project obtained and may handle its copy of the item. NOT A LICENCE, NOT A GRANT AND NOT A PERMISSION: it describes our holding, not the rights the rightsholder confers. Where the item's licence is known it is published as dct:rights instead, and these two predicates never carry the same value. Values: not-redistributable, arxiv-open, personal-copy, reference-only, open-access, author-open, jmlr-open, gold-oa, green-oa-repository-copy." ;
  rdfs:isDefinedBy <https://shir-openu.github.io/meta-tagging-showcase/lod/ns#> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/ns#usedByPapers>
  a rdf:Property ;
  rdfs:label "used by papers" ;
  rdfs:comment "Number of concept-tag ROWS in this corpus that use this term. Equal to the number of distinct records for 6,032 of 6,038 terms; larger for the six where one record names the term more than once. It does not count occurrences in the wider literature, and it counts a term's rows whether or not each row is still live." ;
  rdfs:isDefinedBy <https://shir-openu.github.io/meta-tagging-showcase/lod/ns#> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/ns#reconciliation>
  a rdf:Property ;
  rdfs:label "reconciliation" ;
  rdfs:comment "How this concept was matched to an external authority, and on what evidence." ;
  rdfs:isDefinedBy <https://shir-openu.github.io/meta-tagging-showcase/lod/ns#> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/ns#matchEvidence>
  a rdf:Property ;
  rdfs:label "match evidence" ;
  rdfs:comment "The verbatim string on which a reconciliation match was made." ;
  rdfs:isDefinedBy <https://shir-openu.github.io/meta-tagging-showcase/lod/ns#> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/ns#localId>
  a rdf:Property ;
  rdfs:label "local identifier" ;
  rdfs:comment "The record identifier inside this project. Not stable across a re-staging." ;
  rdfs:isDefinedBy <https://shir-openu.github.io/meta-tagging-showcase/lod/ns#> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/ns#method>
  a rdf:Property ;
  rdfs:label "method" ;
  rdfs:comment "The paper's own stated method, as a field-neutral facet value." ;
  rdfs:isDefinedBy <https://shir-openu.github.io/meta-tagging-showcase/lod/ns#> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/ns#evidence>
  a rdf:Property ;
  rdfs:label "evidence" ;
  rdfs:comment "The exact source passage licensing the statement it hangs on. Verbatim, never paraphrased." ;
  rdfs:isDefinedBy <https://shir-openu.github.io/meta-tagging-showcase/lod/ns#> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/ns#studyLocation>
  a rdf:Property ;
  rdfs:label "study location" ;
  rdfs:comment "Where the study's participants or material were, as distinct from where its authors were." ;
  rdfs:isDefinedBy <https://shir-openu.github.io/meta-tagging-showcase/lod/ns#> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/ns#publicationPlace>
  a rdf:Property ;
  rdfs:label "publication place" ;
  rdfs:comment "Where the item was published, as distinct from where the study took place." ;
  rdfs:isDefinedBy <https://shir-openu.github.io/meta-tagging-showcase/lod/ns#> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/ns#geonames>
  a rdf:Property ;
  rdfs:label "GeoNames entry" ;
  rdfs:comment "The GeoNames resource for a place." ;
  rdfs:isDefinedBy <https://shir-openu.github.io/meta-tagging-showcase/lod/ns#> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/ns#geonamesId>
  a rdf:Property ;
  rdfs:label "GeoNames identifier" ;
  rdfs:comment "The numeric GeoNames identifier for a place." ;
  rdfs:isDefinedBy <https://shir-openu.github.io/meta-tagging-showcase/lod/ns#> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/ns#lat>
  a rdf:Property ;
  rdfs:label "latitude" ;
  rdfs:comment "Latitude in decimal degrees, WGS 84." ;
  rdfs:isDefinedBy <https://shir-openu.github.io/meta-tagging-showcase/lod/ns#> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/ns#long>
  a rdf:Property ;
  rdfs:label "longitude" ;
  rdfs:comment "Longitude in decimal degrees, WGS 84." ;
  rdfs:isDefinedBy <https://shir-openu.github.io/meta-tagging-showcase/lod/ns#> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/ns#storedAs>
  a rdf:Property ;
  rdfs:label "stored as" ;
  rdfs:comment "The local form in which this project holds the item's text." ;
  rdfs:isDefinedBy <https://shir-openu.github.io/meta-tagging-showcase/lod/ns#> .

<https://shir-openu.github.io/meta-tagging-showcase/lod/vocab.html#scheme-disciplines>
  a skos:ConceptScheme ;
  dct:title "Disciplines"@en ;
  dct:description "The field a paper belongs to. Deliberately field-neutral: the same facet is applied to a physics paper and a marketing paper."@en ;
  dct:creator <https://orcid.org/0009-0000-2597-2824> ;
  dct:publisher "Department of Mathematics and Computer Science, The Open University of Israel" ;
  dct:license <https://creativecommons.org/licenses/by/4.0/> ;
